# KathaPulse AI — copy to .env and fill in. Never commit the real .env.
#
# Extraction tier 1 (optional): any OpenAI-compatible vision endpoint.
# Without it the app still works; photo scans fall back to OCR, then to the
# manual-entry panel. It never guesses a medicine.
# KATHA_VISION_API_KEY=gsk_...   # Groq keys start with gsk_; leave blank to disable
KATHA_VISION_BASE_URL=https://api.openai.com/v1
KATHA_VISION_MODEL=gpt-4o-mini
KATHA_VISION_TIMEOUT_S=12
# 1 = send response_format: json_object. Off by default: Groq does not support
# it on every model, and parsing already tolerates fenced/prose-wrapped JSON.
KATHA_VISION_JSON_MODE=0

# Extraction tier 2 (optional): local tesseract.
#   pip install pytesseract pillow
#   apt-get install tesseract-ocr        (needs root)
# Set to 1 to disable OCR even when installed.
# KATHA_OCR_DISABLED=1

# In-app sliding-window backstop, requests/minute per client IP. 0 = off, which
# is the production shape: nginx/Cloudflare own the 30 req/min budget. Set to 30
# for a bare container or LAN install with no proxy in front.
# KATHA_RATE_LIMIT_PER_MIN=0

# Publish /docs, /redoc and /openapi.json? Off by default: a public safety tool
# has no reason to advertise its schema. Set to 1 only on a private deploy.
# KATHA_DOCS_ENABLED=0

# Pharmacist relay (Pass 18 stub). Without a value the /ws/relay endpoint refuses
# every connection, which is the safe default. 16+ characters. Generate your own:
#   openssl rand -hex 32
# KATHA_RELAY_SECRET=

# Server. On a PaaS the platform sets PORT; a real environment variable always
# wins over this file, so the value below is only the local default.
PORT=3004
