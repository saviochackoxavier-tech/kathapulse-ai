        "findings": [
            {
                "code": "DUPLICATE_SALT",
                "severity": "critical",
                "title": {
                    "en": "Same medicine twice",
                    "ml": "\u0d12\u0d30\u0d47 \u0d2e\u0d30\u0d41\u0d28\u0d4d\u0d28\u0d4d \u0d30\u0d23\u0d4d\u0d1f\u0d41\u0d24\u0d35\u0d23",
                    "hi": "\u090f\u0915 \u0939\u0940 \u0926\u0935\u093e \u0926\u094b \u092c\u093e\u0930"
                },
                "message": {
                    "en": "Telmisartan is present in 2 of these strips. Taking them together gives you 80 mg of Telmisartan at once instead of 40 mg.",
                    "ml": "\u0d1f\u0d46\u0d7d\u0d2e\u0d3f\u0d38\u0d3e\u0d7c\u0d1f\u0d4d\u0d1f\u0d7b \u0d08 2 \u0d38\u0d4d\u0d1f\u0d4d\u0d30\u0d3f\u0d2a\u0d4d\u0d2a\u0d41\u0d15\u0d33\u0d3f\u0d32\u0d41\u0d02 \u0d09\u0d23\u0d4d\u0d1f\u0d4d. \u0d30\u0d23\u0d4d\u0d1f\u0d41\u0d02 \u0d12\u0d30\u0d41\u0d2e\u0d3f\u0d1a\u0d4d\u0d1a\u0d4d \u0d15\u0d34\u0d3f\u0d1a\u0d4d\u0d1a\u0d3e\u0d7d \u0d12\u0d31\u0d4d\u0d31\u0d24\u0d4d\u0d24\u0d35\u0d23 40 \u0d2e\u0d3f\u0d32\u0d4d\u0d32\u0d3f\u0d17\u0d4d\u0d30\u0d3e\u0d2e\u0d3f\u0d28\u0d41 \u0d2a\u0d15\u0d30\u0d02 80 \u0d2e\u0d3f\u0d32\u0d4d\u0d32\u0d3f\u0d17\u0d4d\u0d30\u0d3e\u0d02 \u0d1f\u0d46\u0d7d\u0d2e\u0d3f\u0d38\u0d3e\u0d7c\u0d1f\u0d4d\u0d1f\u0d7b \u0d36\u0d30\u0d40\u0d30\u0d24\u0d4d\u0d24\u0d3f\u0d7d \u0d1a\u0d46\u0d32\u0d4d\u0d32\u0d41\u0d02.",
                    "hi": "\u091f\u0947\u0932\u094d\u092e\u093f\u0938\u093e\u0930\u094d\u091f\u0928 \u0907\u0928 2 \u092a\u0924\u094d\u0924\u094b\u0902 \u092e\u0947\u0902 \u0938\u0947 \u0939\u0930 \u090f\u0915 \u092e\u0947\u0902 \u0939\u0948\u0964 \u0926\u094b\u0928\u094b\u0902 \u090f\u0915 \u0938\u093e\u0925 \u0932\u0947\u0928\u0947 \u092a\u0930 \u090f\u0915 \u092c\u093e\u0930 \u092e\u0947\u0902 40 \u092e\u093f\u0932\u0940\u0917\u094d\u0930\u093e\u092e \u0915\u0940 \u091c\u0917\u0939 80 \u092e\u093f\u0932\u0940\u0917\u094d\u0930\u093e\u092e \u091f\u0947\u0932\u094d\u092e\u093f\u0938\u093e\u0930\u094d\u091f\u0928 \u0936\u0930\u0940\u0930 \u092e\u0947\u0902 \u091c\u093e\u090f\u0917\u0940\u0964"
                },
                "action": {
                    "en": "Take only one of them. Keep the other strip aside.",
                    "ml": "\u0d07\u0d35\u0d2f\u0d3f\u0d7d \u0d12\u0d28\u0d4d\u0d28\u0d4d \u0d2e\u0d3e\u0d24\u0d4d\u0d30\u0d02 \u0d15\u0d34\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d15. \u0d2e\u0d31\u0d4d\u0d31\u0d47 \u0d38\u0d4d\u0d1f\u0d4d\u0d30\u0d3f\u0d2a\u0d4d\u0d2a\u0d4d \u0d2e\u0d3e\u0d31\u0d4d\u0d31\u0d3f\u0d35\u0d2f\u0d4d\u0d15\u0d4d\u0d15\u0d41\u0d15.",
                    "hi": "\u0907\u0928\u092e\u0947\u0902 \u0938\u0947 \u0938\u093f\u0930\u094d\u092b\u093c \u090f\u0915 \u0932\u0947\u0902\u0964 \u0926\u0942\u0938\u0930\u093e \u092a\u0924\u094d\u0924\u093e \u0905\u0932\u0917 \u0930\u0916 \u0926\u0947\u0902\u0964"
                },
                "anchors": [
                    "telmisartan"
                ]
            },
            {
                "code": "LASA_RISK",
                "severity": "warning",
                "title": {
                    "en": "Look-alike medicine",
                    "ml": "\u0d38\u0d2e\u0d3e\u0d28\u0d30\u0d42\u0d2a \u0d2e\u0d30\u0d41\u0d28\u0d4d\u0d28\u0d4d",
                    "hi": "\u092e\u093f\u0932\u0924\u0940-\u091c\u0941\u0932\u0924\u0940 \u0926\u0935\u093e"
                },
                "message": {
                    "en": "Telma 40 and Telma-H 40/12.5 look almost the same on the strip, but they do not contain the same medicine. Confusing the two is a common reason for taking the wrong tablet.",
                    "ml": "Telma 40, Telma-H 40/12.5 \u0d0e\u0d28\u0d4d\u0d28\u0d3f\u0d35 \u0d38\u0d4d\u0d1f\u0d4d\u0d30\u0d3f\u0d2a\u0d4d\u0d2a\u0d3f\u0d7d \u0d15\u0d3e\u0d23\u0d3e\u0d7b \u0d12\u0d30\u0d41\u0d2a\u0d4b\u0d32\u0d46\u0d2f\u0d3e\u0d23\u0d4d. \u0d0e\u0d28\u0d4d\u0d28\u0d3e\u0d7d \u0d07\u0d35\u0d2f\u0d3f\u0d7d \u0d05\u0d1f\u0d19\u0d4d\u0d19\u0d3f\u0d2f\u0d3f\u0d30\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28 \u0d2e\u0d30\u0d41\u0d28\u0d4d\u0d28\u0d4d \u0d12\u0d30\u0d41\u0d2a\u0d4b\u0d32\u0d46\u0d2f\u0d32\u0d4d\u0d32. \u0d24\u0d46\u0d31\u0d4d\u0d31\u0d3e\u0d2f \u0d17\u0d41\u0d33\u0d3f\u0d15 \u0d15\u0d34\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28\u0d24\u0d3f\u0d28\u0d4d\u0d31\u0d46 \u0d2a\u0d4d\u0d30\u0d27\u0d3e\u0d28 \u0d15\u0d3e\u0d30\u0d23\u0d02 \u0d07\u0d24\u0d3e\u0d23\u0d4d.",
                    "hi": "Telma 40 \u0914\u0930 Telma-H 40/12.5 \u092a\u0924\u094d\u0924\u0947 \u092a\u0930 \u0932\u0917\u092d\u0917 \u090f\u0915 \u091c\u0948\u0938\u0940 \u0926\u093f\u0916\u0924\u0940 \u0939\u0948\u0902, \u092a\u0930 \u0907\u0928\u092e\u0947\u0902 \u090f\u0915 \u0939\u0940 \u0926\u0935\u093e \u0928\u0939\u0940\u0902 \u0939\u0948\u0964 \u0917\u0932\u0924 \u0917\u094b\u0932\u0940 \u0932\u0947\u0928\u0947 \u0915\u0940 \u092f\u0939 \u0906\u092e \u0935\u091c\u0939 \u0939\u0948\u0964"
                },
                "action": {
                    "en": "Read the full name on the foil, not just the colour. Keep the strips apart.",
                    "ml": "\u0d28\u0d3f\u0d31\u0d02 \u0d2e\u0d3e\u0d24\u0d4d\u0d30\u0d02 \u0d28\u0d4b\u0d15\u0d4d\u0d15\u0d3e\u0d24\u0d46 \u0d2b\u0d4b\u0d2f\u0d3f\u0d32\u0d3f\u0d7d \u0d05\u0d1a\u0d4d\u0d1a\u0d1f\u0d3f\u0d1a\u0d4d\u0d1a \u0d2a\u0d42\u0d7c\u0d23\u0d4d\u0d23\u0d28\u0d3e\u0d2e\u0d02 \u0d35\u0d3e\u0d2f\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d15. \u0d38\u0d4d\u0d1f\u0d4d\u0d30\u0d3f\u0d2a\u0d4d\u0d2a\u0d41\u0d15\u0d7e \u0d35\u0d46\u0d35\u0d4d\u0d35\u0d47\u0d31\u0d46 \u0d38\u0d42\u0d15\u0d4d\u0d37\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d15.",
                    "hi": "\u0938\u093f\u0930\u094d\u092b\u093c \u0930\u0902\u0917 \u0928\u0939\u0940\u0902, \u092b\u093c\u0949\u0907\u0932 \u092a\u0930 \u091b\u092a\u093e \u092a\u0942\u0930\u093e \u0928\u093e\u092e \u092a\u0922\u093c\u0947\u0902\u0964 \u092a\u0924\u094d\u0924\u094b\u0902 \u0915\u094b \u0905\u0932\u0917-\u0905\u0932\u0917 \u0930\u0916\u0947\u0902\u0964"
                },
                "anchors": [
                    "Telma 40",
                    "Telma-H 40/12.5"
                ]
            }
        ],
        "speech": {
            "language": "ml",
            "text": "\u0d15\u0d25\u0d3e\u0d2a\u0d7e\u0d38\u0d4d \u0d2e\u0d41\u0d28\u0d4d\u0d28\u0d31\u0d3f\u0d2f\u0d3f\u0d2a\u0d4d\u0d2a\u0d4d. \u0d12\u0d30\u0d47 \u0d2e\u0d30\u0d41\u0d28\u0d4d\u0d28\u0d4d \u0d30\u0d23\u0d4d\u0d1f\u0d41\u0d24\u0d35\u0d23. \u0d1f\u0d46\u0d7d\u0d2e\u0d3f\u0d38\u0d3e\u0d7c\u0d1f\u0d4d\u0d1f\u0d7b \u0d08 2 \u0d38\u0d4d\u0d1f\u0d4d\u0d30\u0d3f\u0d2a\u0d4d\u0d2a\u0d41\u0d15\u0d33\u0d3f\u0d32\u0d41\u0d02 \u0d09\u0d23\u0d4d\u0d1f\u0d4d. \u0d30\u0d23\u0d4d\u0d1f\u0d41\u0d02 \u0d12\u0d30\u0d41\u0d2e\u0d3f\u0d1a\u0d4d\u0d1a\u0d4d \u0d15\u0d34\u0d3f\u0d1a\u0d4d\u0d1a\u0d3e\u0d7d \u0d12\u0d31\u0d4d\u0d31\u0d24\u0d4d\u0d24\u0d35\u0d23 40 \u0d2e\u0d3f\u0d32\u0d4d\u0d32\u0d3f\u0d17\u0d4d\u0d30\u0d3e\u0d2e\u0d3f\u0d28\u0d41 \u0d2a\u0d15\u0d30\u0d02 80 \u0d2e\u0d3f\u0d32\u0d4d\u0d32\u0d3f\u0d17\u0d4d\u0d30\u0d3e\u0d02 \u0d1f\u0d46\u0d7d\u0d2e\u0d3f\u0d38\u0d3e\u0d7c\u0d1f\u0d4d\u0d1f\u0d7b \u0d36\u0d30\u0d40\u0d30\u0d24\u0d4d\u0d24\u0d3f\u0d7d \u0d1a\u0d46\u0d32\u0d4d\u0d32\u0d41\u0d02. \u0d07\u0d35\u0d2f\u0d3f\u0d7d \u0d12\u0d28\u0d4d\u0d28\u0d4d \u0d2e\u0d3e\u0d24\u0d4d\u0d30\u0d02 \u0d15\u0d34\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d15. \u0d2e\u0d31\u0d4d\u0d31\u0d47 \u0d38\u0d4d\u0d1f\u0d4d\u0d30\u0d3f\u0d2a\u0d4d\u0d2a\u0d4d \u0d2e\u0d3e\u0d31\u0d4d\u0d31\u0d3f\u0d35\u0d2f\u0d4d\u0d15\u0d4d\u0d15\u0d41\u0d15. \u0d05\u0d1f\u0d41\u0d24\u0d4d\u0d24\u0d24\u0d4d. \u0d38\u0d2e\u0d3e\u0d28\u0d30\u0d42\u0d2a \u0d2e\u0d30\u0d41\u0d28\u0d4d\u0d28\u0d4d. Telma 40, Telma-H 40/12.5 \u0d0e\u0d28\u0d4d\u0d28\u0d3f\u0d35 \u0d38\u0d4d\u0d1f\u0d4d\u0d30\u0d3f\u0d2a\u0d4d\u0d2a\u0d3f\u0d7d \u0d15\u0d3e\u0d23\u0d3e\u0d7b \u0d12\u0d30\u0d41\u0d2a\u0d4b\u0d32\u0d46\u0d2f\u0d3e\u0d23\u0d4d. \u0d0e\u0d28\u0d4d\u0d28\u0d3e\u0d7d \u0d07\u0d35\u0d2f\u0d3f\u0d7d \u0d05\u0d1f\u0d19\u0d4d\u0d19\u0d3f\u0d2f\u0d3f\u0d30\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28 \u0d2e\u0d30\u0d41\u0d28\u0d4d\u0d28\u0d4d \u0d12\u0d30\u0d41\u0d2a\u0d4b\u0d32\u0d46\u0d2f\u0d32\u0d4d\u0d32. \u0d24\u0d46\u0d31\u0d4d\u0d31\u0d3e\u0d2f \u0d17\u0d41\u0d33\u0d3f\u0d15 \u0d15\u0d34\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28\u0d24\u0d3f\u0d28\u0d4d\u0d31\u0d46 \u0d2a\u0d4d\u0d30\u0d27\u0d3e\u0d28 \u0d15\u0d3e\u0d30\u0d23\u0d02 \u0d07\u0d24\u0d3e\u0d23\u0d4d. \u0d28\u0d3f\u0d31\u0d02 \u0d2e\u0d3e\u0d24\u0d4d\u0d30\u0d02 \u0d28\u0d4b\u0d15\u0d4d\u0d15\u0d3e\u0d24\u0d46 \u0d2b\u0d4b\u0d2f\u0d3f\u0d32\u0d3f\u0d7d \u0d05\u0d1a\u0d4d\u0d1a\u0d1f\u0d3f\u0d1a\u0d4d\u0d1a \u0d2a\u0d42\u0d7c\u0d23\u0d4d\u0d23\u0d28\u0d3e\u0d2e\u0d02 \u0d35\u0d3e\u0d2f\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d15. \u0d38\u0d4d\u0d1f\u0d4d\u0d30\u0d3f\u0d2a\u0d4d\u0d2a\u0d41\u0d15\u0d7e \u0d35\u0d46\u0d35\u0d4d\u0d35\u0d47\u0d31\u0d46 \u0d38\u0d42\u0d15\u0d4d\u0d37\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d15. \u0d38\u0d02\u0d36\u0d2f\u0d2e\u0d41\u0d23\u0d4d\u0d1f\u0d46\u0d19\u0d4d\u0d15\u0d3f\u0d7d \u0d2b\u0d3e\u0d7c\u0d2e\u0d38\u0d3f\u0d38\u0d4d\u0d31\u0d4d\u0d31\u0d3f\u0d28\u0d4b\u0d1f\u0d4d \u0d1a\u0d4b\u0d26\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d15.",
            "rate": 0.85,
            "pause_before": 0.25
        }
    },
    "disclaimer": {
        "en": "KathaPulse AI is a screening aid, not a diagnosis. Always confirm with a doctor or pharmacist.",
        "ml": "\u0d15\u0d25\u0d3e\u0d2a\u0d7e\u0d38\u0d4d AI \u0d12\u0d30\u0d41 \u0d38\u0d39\u0d3e\u0d2f \u0d2e\u0d41\u0d28\u0d4d\u0d28\u0d31\u0d3f\u0d2f\u0d3f\u0d2a\u0d4d\u0d2a\u0d4d \u0d2e\u0d3e\u0d24\u0d4d\u0d30\u0d2e\u0d3e\u0d23\u0d4d, \u0d30\u0d4b\u0d17\u0d28\u0d3f\u0d7c\u0d23\u0d2f\u0d2e\u0d32\u0d4d\u0d32. \u0d0e\u0d2a\u0d4d\u0d2a\u0d4b\u0d34\u0d41\u0d02 \u0d21\u0d4b\u0d15\u0d4d\u0d1f\u0d31\u0d46\u0d2f\u0d4b \u0d2b\u0d3e\u0d7c\u0d2e\u0d38\u0d3f\u0d38\u0d4d\u0d31\u0d4d\u0d31\u0d3f\u0d28\u0d46\u0d2f\u0d4b \u0d38\u0d4d\u0d25\u0d3f\u0d30\u0d40\u0d15\u0d30\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d15.",
        "hi": "\u0915\u0925\u093e\u092a\u0932\u094d\u0938 AI \u0938\u093f\u0930\u094d\u092b\u093c \u090f\u0915 \u091a\u0947\u0924\u093e\u0935\u0928\u0940 \u0938\u0939\u093e\u092f\u0915 \u0939\u0948, \u0928\u093f\u0926\u093e\u0928 \u0928\u0939\u0940\u0902\u0964 \u0939\u092e\u0947\u0936\u093e \u0921\u0949\u0915\u094d\u091f\u0930 \u092f\u093e \u092b\u093e\u0930\u094d\u092e\u093e\u0938\u093f\u0938\u094d\u091f \u0938\u0947 \u092a\u0941\u0937\u094d\u091f\u093f \u0915\u0930\u0947\u0902\u0964"
    },
    "language": "ml",
    "processed_in_memory": true,
    "image_bytes_received": 0,
    "safety_message_ml": "\u0d15\u0d25\u0d3e\u0d2a\u0d7e\u0d38\u0d4d \u0d2e\u0d41\u0d28\u0d4d\u0d28\u0d31\u0d3f\u0d2f\u0d3f\u0d2a\u0d4d\u0d2a\u0d4d. \u0d12\u0d30\u0d47 \u0d2e\u0d30\u0d41\u0d28\u0d4d\u0d28\u0d4d \u0d30\u0d23\u0d4d\u0d1f\u0d41\u0d24\u0d35\u0d23. \u0d1f\u0d46\u0d7d\u0d2e\u0d3f\u0d38\u0d3e\u0d7c\u0d1f\u0d4d\u0d1f\u0d7b \u0d08 2 \u0d38\u0d4d\u0d1f\u0d4d\u0d30\u0d3f\u0d2a\u0d4d\u0d2a\u0d41\u0d15\u0d33\u0d3f\u0d32\u0d41\u0d02 \u0d09\u0d23\u0d4d\u0d1f\u0d4d. \u0d30\u0d23\u0d4d\u0d1f\u0d41\u0d02 \u0d12\u0d30\u0d41\u0d2e\u0d3f\u0d1a\u0d4d\u0d1a\u0d4d \u0d15\u0d34\u0d3f\u0d1a\u0d4d\u0d1a\u0d3e\u0d7d \u0d12\u0d31\u0d4d\u0d31\u0d24\u0d4d\u0d24\u0d35\u0d23 40 \u0d2e\u0d3f\u0d32\u0d4d\u0d32\u0d3f\u0d17\u0d4d\u0d30\u0d3e\u0d2e\u0d3f\u0d28\u0d41 \u0d2a\u0d15\u0d30\u0d02 80 \u0d2e\u0d3f\u0d32\u0d4d\u0d32\u0d3f\u0d17\u0d4d\u0d30\u0d3e\u0d02 \u0d1f\u0d46\u0d7d\u0d2e\u0d3f\u0d38\u0d3e\u0d7c\u0d1f\u0d4d\u0d1f\u0d7b \u0d36\u0d30\u0d40\u0d30\u0d24\u0d4d\u0d24\u0d3f\u0d7d \u0d1a\u0d46\u0d32\u0d4d\u0d32\u0d41\u0d02. \u0d07\u0d35\u0d2f\u0d3f\u0d7d \u0d12\u0d28\u0d4d\u0d28\u0d4d \u0d2e\u0d3e\u0d24\u0d4d\u0d30\u0d02 \u0d15\u0d34\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d15. \u0d2e\u0d31\u0d4d\u0d31\u0d47 \u0d38\u0d4d\u0d1f\u0d4d\u0d30\u0d3f\u0d2a\u0d4d\u0d2a\u0d4d \u0d2e\u0d3e\u0d31\u0d4d\u0d31\u0d3f\u0d35\u0d2f\u0d4d\u0d15\u0d4d\u0d15\u0d41\u0d15. \u0d05\u0d1f\u0d41\u0d24\u0d4d\u0d24\u0d24\u0d4d. \u0d38\u0d2e\u0d3e\u0d28\u0d30\u0d42\u0d2a \u0d2e\u0d30\u0d41\u0d28\u0d4d\u0d28\u0d4d. Telma 40, Telma-H 40/12.5 \u0d0e\u0d28\u0d4d\u0d28\u0d3f\u0d35 \u0d38\u0d4d\u0d1f\u0d4d\u0d30\u0d3f\u0d2a\u0d4d\u0d2a\u0d3f\u0d7d \u0d15\u0d3e\u0d23\u0d3e\u0d7b \u0d12\u0d30\u0d41\u0d2a\u0d4b\u0d32\u0d46\u0d2f\u0d3e\u0d23\u0d4d. \u0d0e\u0d28\u0d4d\u0d28\u0d3e\u0d7d \u0d07\u0d35\u0d2f\u0d3f\u0d7d \u0d05\u0d1f\u0d19\u0d4d\u0d19\u0d3f\u0d2f\u0d3f\u0d30\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28 \u0d2e\u0d30\u0d41\u0d28\u0d4d\u0d28\u0d4d \u0d12\u0d30\u0d41\u0d2a\u0d4b\u0d32\u0d46\u0d2f\u0d32\u0d4d\u0d32. \u0d24\u0d46\u0d31\u0d4d\u0d31\u0d3e\u0d2f \u0d17\u0d41\u0d33\u0d3f\u0d15 \u0d15\u0d34\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d28\u0d4d\u0d28\u0d24\u0d3f\u0d28\u0d4d\u0d31\u0d46 \u0d2a\u0d4d\u0d30\u0d27\u0d3e\u0d28 \u0d15\u0d3e\u0d30\u0d23\u0d02 \u0d07\u0d24\u0d3e\u0d23\u0d4d. \u0d28\u0d3f\u0d31\u0d02 \u0d2e\u0d3e\u0d24\u0d4d\u0d30\u0d02 \u0d28\u0d4b\u0d15\u0d4d\u0d15\u0d3e\u0d24\u0d46 \u0d2b\u0d4b\u0d2f\u0d3f\u0d32\u0d3f\u0d7d \u0d05\u0d1a\u0d4d\u0d1a\u0d1f\u0d3f\u0d1a\u0d4d\u0d1a \u0d2a\u0d42\u0d7c\u0d23\u0d4d\u0d23\u0d28\u0d3e\u0d2e\u0d02 \u0d35\u0d3e\u0d2f\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d15. \u0d38\u0d4d\u0d1f\u0d4d\u0d30\u0d3f\u0d2a\u0d4d\u0d2a\u0d41\u0d15\u0d7e \u0d35\u0d46\u0d35\u0d4d\u0d35\u0d47\u0d31\u0d46 \u0d38\u0d42\u0d15\u0d4d\u0d37\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d15. \u0d38\u0d02\u0d36\u0d2f\u0d2e\u0d41\u0d23\u0d4d\u0d1f\u0d46\u0d19\u0d4d\u0d15\u0d3f\u0d7d \u0d2b\u0d3e\u0d7c\u0d2e\u0d38\u0d3f\u0d38\u0d4d\u0d31\u0d4d\u0d31\u0d3f\u0d28\u0d4b\u0d1f\u0d4d \u0d1a\u0d4b\u0d26\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d15.",
    "safety_message_hi": "\u0915\u0925\u093e\u092a\u0932\u094d\u0938 \u091a\u0947\u0924\u093e\u0935\u0928\u0940\u0964 \u090f\u0915 \u0939\u0940 \u0926\u0935\u093e \u0926\u094b \u092c\u093e\u0930. \u091f\u0947\u0932\u094d\u092e\u093f\u0938\u093e\u0930\u094d\u091f\u0928 \u0907\u0928 2 \u092a\u0924\u094d\u0924\u094b\u0902 \u092e\u0947\u0902 \u0938\u0947 \u0939\u0930 \u090f\u0915 \u092e\u0947\u0902 \u0939\u0948\u0964 \u0926\u094b\u0928\u094b\u0902 \u090f\u0915 \u0938\u093e\u0925 \u0932\u0947\u0928\u0947 \u092a\u0930 \u090f\u0915 \u092c\u093e\u0930 \u092e\u0947\u0902 40 \u092e\u093f\u0932\u0940\u0917\u094d\u0930\u093e\u092e \u0915\u0940 \u091c\u0917\u0939 80 \u092e\u093f\u0932\u0940\u0917\u094d\u0930\u093e\u092e \u091f\u0947\u0932\u094d\u092e\u093f\u0938\u093e\u0930\u094d\u091f\u0928 \u0936\u0930\u0940\u0930 \u092e\u0947\u0902 \u091c\u093e\u090f\u0917\u0940\u0964 \u0907\u0928\u092e\u0947\u0902 \u0938\u0947 \u0938\u093f\u0930\u094d\u092b\u093c \u090f\u0915 \u0932\u0947\u0902\u0964 \u0926\u0942\u0938\u0930\u093e \u092a\u0924\u094d\u0924\u093e \u0905\u0932\u0917 \u0930\u0916 \u0926\u0947\u0902\u0964 \u0905\u0917\u0932\u093e\u0964 \u092e\u093f\u0932\u0924\u0940-\u091c\u0941\u0932\u0924\u0940 \u0926\u0935\u093e. Telma 40 \u0914\u0930 Telma-H 40/12.5 \u092a\u0924\u094d\u0924\u0947 \u092a\u0930 \u0932\u0917\u092d\u0917 \u090f\u0915 \u091c\u0948\u0938\u0940 \u0926\u093f\u0916\u0924\u0940 \u0939\u0948\u0902, \u092a\u0930 \u0907\u0928\u092e\u0947\u0902 \u090f\u0915 \u0939\u0940 \u0926\u0935\u093e \u0928\u0939\u0940\u0902 \u0939\u0948\u0964 \u0917\u0932\u0924 \u0917\u094b\u0932\u0940 \u0932\u0947\u0928\u0947 \u0915\u0940 \u092f\u0939 \u0906\u092e \u0935\u091c\u0939 \u0939\u0948\u0964 \u0938\u093f\u0930\u094d\u092b\u093c \u0930\u0902\u0917 \u0928\u0939\u0940\u0902, \u092b\u093c\u0949\u0907\u0932 \u092a\u0930 \u091b\u092a\u093e \u092a\u0942\u0930\u093e \u0928\u093e\u092e \u092a\u0922\u093c\u0947\u0902\u0964 \u092a\u0924\u094d\u0924\u094b\u0902 \u0915\u094b \u0905\u0932\u0917-\u0905\u0932\u0917 \u0930\u0916\u0947\u0902\u0964 \u0915\u094b\u0908 \u0936\u0902\u0915\u093e \u0939\u094b \u0924\u094b \u092b\u093e\u0930\u094d\u092e\u093e\u0938\u093f\u0938\u094d\u091f \u0938\u0947 \u092a\u0942\u091b\u0947\u0902\u0964",
    "safety_message_en": "KathaPulse warning. Same medicine twice. Telmisartan is present in 2 of these strips. Taking them together gives you 80 mg of Telmisartan at once instead of 40 mg. Take only one of them. Keep the other strip aside. Next. Look-alike medicine. Telma 40 and Telma-H 40/12.5 look almost the same on the strip, but they do not contain the same medicine. Confusing the two is a common reason for taking the wrong tablet. Read the full name on the foil, not just the colour. Keep the strips apart. For any doubt, ask your pharmacist.",
    "duplicate_salt_warning": true,
    "lasa_risk": true
}
